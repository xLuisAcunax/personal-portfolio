---
/** Scroll progress bar pinned to the top of the viewport. */
---

<div
  id="reading-progress"
  aria-hidden="true"
  class="pointer-events-none fixed top-0 left-0 z-[9998] h-0.5 w-full"
  style="background:linear-gradient(90deg,var(--c-teal),var(--c-yellow),var(--c-orange)); transform-origin:left center; transform:scaleX(0);"
>
</div>
