---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Tag from "../../components/ui/Tag.astro";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, summary, cover, stack, link, repo } = entry.data;
const { Content } = await entry.render();
---

<Layout title={`${title} — Project`} description={summary}>
  <article class="mx-auto max-w-3xl px-6 pt-36 pb-24">
    <a href="/#projects" class="font-mono text-xs tracking-[0.12em] text-muted hover:text-fg">
      ← Back
    </a>

    <h1 class="mt-5 text-[clamp(32px,5vw,52px)] font-extrabold tracking-[-0.03em]">{title}</h1>
    <p class="mt-3 text-[15.5px] leading-relaxed text-muted">{summary}</p>

    {
      cover && (
        <img
          src={cover}
          alt={title}
          loading="lazy"
          class="mt-8 w-full rounded-2xl border border-line"
        />
      )
    }

    <div class="mt-5 flex flex-wrap gap-2">
      {stack.map((tech) => <Tag>{tech}</Tag>)}
    </div>

    <div class="rich-text mt-8 text-[15px] leading-[1.8] text-muted">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-5 border-t border-line pt-6">
      {
        link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-teal">
            Visit Site →
          </a>
        )
      }
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-bold text-muted hover:text-fg"
          >
            View Code
          </a>
        )
      }
    </div>
  </article>
</Layout>
