---
import "../styles/global.css";
import { SITE } from "../config/site";
import Backdrop from "../components/layout/Backdrop.astro";
import Footer from "../components/layout/Footer.astro";
import NavBar from "../components/layout/NavBar.astro";
import PointerCursor from "../components/layout/PointerCursor.astro";
import ReadingProgress from "../components/layout/ReadingProgress.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = `${SITE.brand} — ${SITE.role}`,
  description =
    "Senior Full Stack Developer and Cloud Solutions Architect with 12+ years building scalable .NET, Angular and cloud-native systems.",
  keywords =
    "Software Engineer, .NET, Angular, Azure, Cloud Architect, Full Stack Developer, C#, TypeScript",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/portfolio.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.brand,
  image: new URL(SITE.avatar, Astro.site).href,
  jobTitle: "Senior Software Engineer",
  url: SITE.domain,
  email: `mailto:${SITE.email}`,
  worksFor: { "@type": "Organization", name: "GlobalLogic" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Barranquilla",
    addressCountry: "CO",
  },
  sameAs: [SITE.github, SITE.linkedin],
  knowsAbout: [
    "C#",
    ".NET",
    "Angular",
    "Azure",
    "Google Cloud",
    "SQL Server",
    "MongoDB",
    "Node.js",
    "TypeScript",
    "Microservices",
    "CI/CD",
    "DevOps",
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#0b0f14" />
    <meta
      name="google-site-verification"
      content="VH-nhUqUBsA6xxoj_Gm-5JVXPK2NdypfYtO7g5Z305I"
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300..900&family=Google+Sans+Code:wght@300..800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />

    {/* Applied before first paint so the stored theme never flashes. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.dataset.js = "true";
        var stored = null;
        try {
          stored = window.localStorage.getItem("la-theme");
        } catch (error) {
          /* storage unavailable */
        }
        root.dataset.theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
      })();
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PNH39ZJDM1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-PNH39ZJDM1");
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>

  <body class="relative min-h-dvh overflow-x-hidden">
    <Backdrop />
    <ReadingProgress />
    <PointerCursor />
    <NavBar />

    <main class="relative z-[1]">
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
